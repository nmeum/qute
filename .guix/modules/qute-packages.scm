(define (pipe-command command)
  (let* ((port (apply open-pipe* OPEN_READ command))
         (output (string-trim-right (read-string port))))
    (close-port port)
    output))

(define %srcdir
  (pipe-command '("git" "rev-parse" "--show-toplevel")))

