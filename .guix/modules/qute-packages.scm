;; TODO: This can be removed once scc-0.2 has been released.
;; See <https://git.simple-cc.org/scc/commit/575a2d87cac49174b7f53aa6ac5f9186c2165697.html>.
(define-public simple-cc
  (let ((commit "1a40da012b84fe407ddf09d3908793d4a3bc4898")
        (revision "2"))
    (package/inherit c:simple-cc
      (name "simple-cc")
      (version (git-version (package-version c:simple-cc) revision commit))
      (source
        (origin
          (method git-fetch)
          (uri (git-reference
                 (url "https://git.8pit.net/scc.git")
                 (commit commit)))
          (file-name (git-file-name name version))
          (sha256
            (base32 "1nhnp9wnb25d04vpfh45c8944ibwqi7rmjkr9qzmd5h3wlvp7a94"))))
      (arguments
        (substitute-keyword-arguments (package-arguments c:simple-cc)
          ((#:tests? _ #f) #f) ;; TODO: Figure out why tests fail on Git HEAD.
          ((#:phases phases #~%standard-phases)
           #~(modify-phases #$phases
               ;; gcc-scc.sh has been removed in Git HEAD, create an empty file to
               ;; allow using the existing 'fix-paths phase without it erroring.
               (add-before 'fix-paths 'touch-dummy
                 (lambda _
                   (call-with-output-file "src/libc/gcc-scc.sh" (const #t))))
               (add-after 'build 'build-qute-libc
                 (lambda _
                   (invoke "make" "-f" "main.mk"
                           (string-append "CC=" (getcwd) "/bin/scc")
                           "CONF=amd64-qute"
                           "libc"))))))))))

;; ktest-tool python script from KLEE for inspecting .ktest file
;; generated by qute-symex(1) from the qute-cli package.
(define-public ktest-tool
  (package/inherit klee
    (name "ktest-tool")
    (build-system copy-build-system)
    (inputs (list python-minimal))
    (native-inputs '())
    (arguments
      (list
        #:phases
        #~(modify-phases %standard-phases
            (add-after 'unpack 'fix-shebang
              (lambda* (#:key inputs #:allow-other-keys)
                (substitute* "tools/ktest-tool/ktest-tool"
                  (("#!/usr/bin/env python3")
                   (string-append
                     "#!"
                     (search-input-file inputs "/bin/python3")))))))
        #:install-plan
        #~'(("tools/ktest-tool/ktest-tool" "bin/ktest-tool"))))
    (home-page "https://klee-se.org")
    (synopsis "Tool for KLEE's ktest test input format")))

